# ---------------------------------------------------------------------------
# Database
# Phase hien tai: SQLite (khong can cai dat gi them)
# Khi chuyen sang Postgres, xem docs/POSTGRES-MIGRATION.md
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# Postgres (dung sau nay):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vn_investment?schema=public"

# ---------------------------------------------------------------------------
# Tai khoan Admin khoi tao (chay boi prisma/seed.ts)
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@vninvest.local"
ADMIN_PASSWORD="ChangeMe@2026"
ADMIN_FULL_NAME="System Administrator"

# ===========================================================================
# MARKET DATA SERVICE (Phase 07)  —  NGUON GIA KHAI BAO O DAY
# ===========================================================================
#
# LUU Y QUAN TRONG:
# vnstock KHONG phai mot REST API co endpoint + API key de dan vao. No la mot
# THU VIEN PYTHON boc cac nguon du lieu cong khai (VCI, KBS, DNSE...).
# Vi vay o day khong co o "API URL" hay "API key" cho gia — thu ban cau hinh la
# NGUON CON nao, va bao lau lay mot lan.
#
# Kien truc:  vnstock -> services/market-data -> POST /api/market-data/ingest
#             -> database -> Portfolio Engine -> Dashboard
# Trinh duyet KHONG BAO GIO goi vnstock truc tiep (§23).

# --- Nguon con cua vnstock -------------------------------------------------
# vci   nen dung: co bang gia day du (tran/san/tham chieu) cho nhieu ma mot lan
# kbs   mac dinh cua thu vien, cung ho tro Quote
# dnse  nguon thay the
# msn   du lieu quoc te, KHONG dung cho co phieu Viet Nam
MARKET_DATA_PROVIDER="vci"

# --- Xac thuc giua service va app ----------------------------------------
# Chuoi ngau nhien, phai GIONG NHAU o ca hai phia. Sinh bang:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# De trong thi cong nap du lieu bi dong hoan toan (mac dinh an toan).
MARKET_DATA_INGEST_TOKEN=""
MARKET_DATA_INGEST_URL="http://127.0.0.1:3000/api/market-data/ingest"

# --- API key cua vnstock (TUY CHON) --------------------------------------
#
# !!! DAY LA FILE MAU, SE DUOC COMMIT VAO GIT. KHONG DAN SECRET VAO DAY. !!!
# Dan key that vao file `.env` (da duoc gitignore), khong phai file nay.
#
# Key cua vnstock co nhieu tier. `python sync.py check` in ra tier THAT va han muc
# that do thu vien bao. De trong thi thu vien van chay.
# Mua goi tai: https://vnstocks.com/insiders-program
VNSTOCK_API_KEY=""

# --- Nhip do ------------------------------------------------------------
#
# LUU Y: nguong "gia da cu" (stale) KHONG nam o day. No la mot tham so cau hinh
# trong bang system_settings (key: market_data.stale_after_minutes) de Admin doi
# duoc luc dang chay ma khong phai deploy lai — dung yeu cau §19.
# Xem gia tri hien tai:  npx tsx scripts/set-setting.ts
# Doi gia tri:           npx tsx scripts/set-setting.ts market_data.refresh_after_minutes 120
# CHU KY THUC DAY, khong phai chu ky goi nguon gia.
#
# Moi lan thuc day, tien trinh hoi app "gia dang cu bao nhieu phut" va chi goi
# VNStock khi da qua nguong market_data.refresh_after_minutes (mac dinh 120 phut).
# Nho vay luot bam nut "Cap nhat gia" cua nguoi dung cung duoc tinh: vua bam xong
# thi luot tu dong ke tiep tu lui lai.
#
# 300s = biet gia da cu trong vong 5 phut ke tu luc no vuot nguong. Dat nho hon
# khong lam gia tuoi hon, chi lam tien trinh hoi app day hon.
MARKET_DATA_INTERVAL_SECONDS="300"
MARKET_DATA_BATCH_SIZE="50"
MARKET_DATA_REQUEST_TIMEOUT="30"
# Cho toi da bao nhieu giay cho MOT lan bam nut "Cap nhat gia" tren trang Market Data.
#
# Doc boi server action (KHONG phai boi Python) — xem src/market/actions.ts. Het moc nay
# thi tien trinh con bi dung va dong nhat ky duoc danh dau FAILED. Moc nay cung la moc
# don dong RUNNING treo: qua no thi chac chan khong con ai cap nhat dong ay nua.
#
# Lay gia 12 ma thuong mat 2-20 giay. De cao hon neu theo doi nhieu ma.
MARKET_DATA_SYNC_TIMEOUT="180"


# --- Gio giao dich (ICT) ------------------------------------------------
# HOSE/HNX: 09:00-15:00, thu Hai den thu Sau.
MARKET_SESSION_START_HOUR="9"
MARKET_SESSION_END_HOUR="15"
# Cho bao lau sau gio dong cua roi moi lay gia chot phien.
# Gia dong cua duoc xac dinh o phien ATC nhung nguon can vai giay de cong bo.
# Tang neu log bao nhieu ma phai dung gia tham chieu.
MARKET_CLOSE_DELAY_SECONDS="30"
# Dat "1" de bo qua kiem tra gio — dung khi test ngoai gio giao dich.
MARKET_DATA_IGNORE_HOURS=""

# --- Chi so tham chieu de tinh Alpha (§13) ------------------------------
MARKET_DATA_INDICES="VNINDEX"


# ==========================================================================
#  RISK ENGINE (§19) — Phase 09
# ==========================================================================
#
# Tuoi toi da cua luot quet gan nhat truoc khi "quet lazy" tu kich hoat (giay).
# Mo mot trang co canh bao (Dashboard, Risk) se quet lai neu luot gan nhat da cu
# hon nguong nay; con moi thi doc lai ket qua cu.
#
# Day la tham so TRIEN KHAI, khong phai quy tac nghiep vu — no khong nam trong
# system_settings. Cung ly do voi MARKET_DATA_INTERVAL_SECONDS o tren.
#
# Dat cao: nhe may hon, nhung canh bao co the tre toi bang nguong nay.
# Dat thap: canh bao tuoi hon, nhung moi lan mo trang deu chay lai ca engine.
RISK_SCAN_MAX_AGE_SECONDS="300"

# Quet dinh ky KHONG phu thuoc vao viec co ai mo trang:
#   POST /api/risk/scan   header  x-market-data-token: <MARKET_DATA_INGEST_TOKEN>
# Hoac dung san:  npm run risk:scan
# Endpoint dung lai MARKET_DATA_INGEST_TOKEN o tren — cung mot muc tin cay
# ("tien trinh nen cua chinh he thong nay duoc phep ghi"), khong them secret moi.
